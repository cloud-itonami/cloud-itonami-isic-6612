{:paths ["src"]
 ;; langgraph-clj brings langchain-clj transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the com-junkawasaki org of this workspace. This repo is standalone
 ;; (forkable outside the workspace); the :local/root paths only resolve
 ;; inside the monorepo checkout — a standalone fork should override them
 ;; with git coordinates.
 :deps {
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.robotics.process: the process-physics solvers and probe this
        ;; repo's physics.edn runs on (physical-AI bot, scripts/physical-ai-bots).
        io.github.kotoba-lang/robotics {:local/root "../../kotoba-lang/robotics"}

        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "f9ef46980869cc0bedddc3c552ccfd7add7cffe0"}
        ;; html/css を top-level で git 座標に固定する。推移依存(:local/root)と
        ;; jp-go-dds(:git/sha)で座標型が違うと tools.deps が版を比較できない。
        io.github.kotoba-lang/html
        {:git/url "https://github.com/kotoba-lang/html" :git/sha "00a4c2ad43dde3df9d54b658961143c53945a379"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/css" :git/sha "6eda5ee28ec177b9e09fdbee92c55a050b18cf7d"}
io.github.com-junkawasaki/langgraph-clj
        {:local/root "../../kotoba-lang/langgraph"}
        ;; optional: brokerage.corporate-intel's cross-reference into
        ;; cloud-itonami-isic-8291 (ADR-2607110400 §5 pattern, first
        ;; applied to formation.corporate-intel in cloud-itonami-isic-6910).
        ;; Only brokerage.corporate-intel itself requires `dossier.*` --
        ;; brokerllm/operation/governor have zero compile-time dependency
        ;; on it (the screen fn is plain-injected).
        io.github.cloud-itonami/cloud-itonami-isic-8291
        {:local/root "../cloud-itonami-isic-8291"}}
 :aliases
 {
  ;; kbb -M:physics -> the physical-AI bot's measurement: runs physics.edn on
  ;; kotoba.robotics.process and prints one probe map. Exit 2 = could not measure.
  :physics {:main-opts ["-m" "kotoba.robotics.process.probe"]}
  ;; kbb -M:physai-test -> test/'s .cljk on kbb's runner (the bot's test count;
  ;; a .kotoba vertical's own :test may refuse kbb on purpose).
  ;; test/'s namespaces minus these, which cannot load on kbb (the full suite stays on :test, fleet JVM gate):
  ;; - brokerage.corporate-intel-test: reaches dossier.* in cloud-itonami-isic-8291, .kotoba-only on main
  ;; - brokerage.portable-cljs-test-runner: a cljs.main entry (*main-cli-fn*); its tests run here
  ;; - wasm.trade-value-mismatch-test: JVM-only by design (kototama.tender on the chicory wasm runtime)
  :physai-test {:extra-paths ["test" "test-physai"]
                :main-opts ["-m" "cognitect.test-runner"
                            "-n" "brokerage.physics-spec-test"
                            "-n" "brokerage.facts-test"
                            "-n" "brokerage.governor-contract-test"
                            "-n" "brokerage.kernels.gate-test"
                            "-n" "brokerage.phase-test"
                            "-n" "brokerage.registry-test"
                            "-n" "brokerage.store-contract-test"]}
;; offline workspace dev -- pin transitive langchain-clj to local checkout
  :dev {:override-deps
        {io.github.com-junkawasaki/langchain-clj
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "brokerage.sim"]}
  ;; kbb -M:dev:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300 Wave5 seq 22).
  :render-html {:main-opts ["-m" "brokerage.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; kototama.tender hosts the
                      ;; wasm/trade_value_mismatch.kotoba build (see
                      ;; wasm/README.md) -- test-only, the actor's own
                      ;; runtime code has no wasm/host dependency.
                      io.github.kotoba-lang/kototama
                      {:local/root "../../kotoba-lang/kototama"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; PRIMARY gate: the same portable .cljc suite under a real
  ;; ClojureScript host (runtime priority: cljs first, JVM compat).
  ;;   kbb -Sdeps '{:paths ["src" "test"]}' -M:dev:cljs \
  ;;     -m cljs.main --target node -m brokerage.portable-cljs-test-runner
  :cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}}}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
